{
  "name": "clawd-flotante",
  "version": "1.11.0",
  "description": "Pixel Pal: Desktop Pet — una mascota de escritorio que muestra el progreso de tus sesiones de Claude Code",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "start:personal": "set PAL_EDITION=personal&& electron .",
    "test": "node --test \"tests/unit/*.test.js\" && node --test --test-concurrency=1 \"tests/e2e/*.test.js\"",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "icon": "node tools/make-icon.js",
    "dist": "node tools/build-watcher.js && electron-builder --win nsis",
    "build:watcher": "node tools/build-watcher.js",
    "build:apk": "node tools/build-apk.js"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "playwright-core": "^1.65.0"
  },
  "author": "Tomás",
  "build": {
    "appId": "com.clawd.flotante.compartido",
    "productName": "Pixel Pal",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "edition.js",
      "phone.js",
      "hooks.js",
      "preload.js",
      "preload-ui.js",
      "preload-sessions.js",
      "preload-shop.js",
      "preload-brain.js",
      "brain.js",
      "renderer/**",
      "scripts/*.exe",
      "package.json"
    ],
    "asarUnpack": [
      "scripts/**",
      "renderer/media/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "legalTrademarks": "Pixel Pal"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pixel Pal",
      "runAfterFinish": true,
      "include": "build/installer.nsh",
      "artifactName": "Pixel-Pal-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false
    },
    "copyright": "© 2026 Pixel Pal"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "qrcode": "^1.5.4"
  }
}
