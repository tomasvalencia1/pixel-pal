<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:contentDescription="@null"
            android:src="@drawable/pal_big" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/card"
            android:lineSpacingExtra="4dp"
            android:padding="16dp"
            android:textColor="@color/text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/warn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="⚠️ Las notificaciones están desactivadas: no verás los avisos."
            android:textColor="@color/alert"
            android:visibility="gone" />

        <Button
            android:id="@+id/scan"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="📷 Escanear el QR de Pal" />

        <Button
            android:id="@+id/code"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⌨️ Escribir el código" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Cómo avisarte"
            android:textColor="@color/text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Activado = ⏰ alarma: Pal aparece en pantalla completa y te lo cuenta en voz alta. Desactivado = 🔔 notificación normal."
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swDone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✅ Claude terminó"
            android:textColor="@color/text"
            android:textSize="15sp" />
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swWaiting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✋ Necesita tu permiso"
            android:textColor="@color/text"
            android:textSize="15sp" />
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚠️ Error o límite de uso"
            android:textColor="@color/text"
            android:textSize="15sp" />
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swVoice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🗣️ Que Pal lo diga en voz alta"
            android:textColor="@color/text"
            android:textSize="15sp" />
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swSound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⏰ Además, sonido de alarma"
            android:textColor="@color/text"
            android:textSize="15sp" />

        <Button
            android:id="@+id/testAlarm"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⏰ Probar la alarma" />

        <TextView
            android:id="@+id/permsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Para que la alarma funcione siempre"
            android:textColor="@color/text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/permFull"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📱 Permitir pantalla completa" />
        <Button
            android:id="@+id/permOverlay"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🪟 Mostrar sobre otras apps" />
        <Button
            android:id="@+id/permBattery"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔋 No dormir la app (batería)" />

        <Button
            android:id="@+id/notifs"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="🔔 Ajustes de notificaciones" />

        <Button
            android:id="@+id/test"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👀 Ver cómo es un aviso" />

        <Button
            android:id="@+id/unpair"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Desemparejar" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Pal solo envía el nombre del proyecto y el estado; nunca lo que escribes ni tu código."
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
